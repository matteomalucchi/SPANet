{
    "hidden_dim": {"type": "choice", "values": [32, 64, 96, 128]},

    "num_encoder_layers": {"type": "randint", "low": 1, "high": 7},
    "num_branch_embedding_layers": {"type": "choice", "values": [1, 2, 4, 6]},
    "num_branch_encoder_layers": {"type": "choice", "values": [1, 2, 4, 6]},

    "num_regression_layers": [1, 2, 4, 6],
    "num_classification_layers": [1, 2, 4, 6],

    "learning_rate": {"type": "loguniform", "low": 1e-5, "high": 1e-1},
    "l2_penalty": {"type": "loguniform", "low": 1e-6, "high": 1e-2},
    "focal_gamma": {"type": "uniform", "low": 0.0, "high": 1.0},
    "dropout": {"type": "quniform", "low": 0.0, "high": 0.3, "q": 0.05},

    "transformer_type": ["Gated", "NormFirst", "Standard"],
    "linear_block_type": ["GRU", "Gated", "Resnet"],

    "batch_size": 1024
}
